{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "smm-control-center",
  "version": "0.1.4",
  "identifier": "com.smm.controlcenter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SMM Control Center",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:smm_local.db"
      ]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/prochatbottech/SMM-Control-Center/releases/latest/download/latest.json",
        "https://gitverse.ru/api/v1/repos/prochatbottech/SMM-Control-Center/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRDI5RTk1MzBFMUQxMjQKUldRazBlRXdsWjdTMzRscFByRU9ra0tFc21LM1B1WVdIbVRtdkhvRlUwblIwTktON21oSmVxNUoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb"],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
